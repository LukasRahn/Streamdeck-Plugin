        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "^20.19.43",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "tsx": "^4.23.15",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0",
        "@resvg/resvg-wasm": "^2.6.2"
